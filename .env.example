# Chave da API do Groq (usada para o chat de acolhimento em tempo real — Llama 3.3)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=

# Chave da API do Google Gemini (gratuita)
# Obtenha em: https://aistudio.google.com → "Get API key"
GOOGLE_AI_API_KEY=

# Configurações do Gmail SMTP para envio dos perfis de pacientes
# Use uma "Senha de app" do Google (não a senha normal da conta)
# Crie em: myaccount.google.com/apppasswords
GMAIL_USER=julia.m.floresss@gmail.com
GMAIL_APP_PASSWORD=

# Email de destino dos perfis gerados (email da psicóloga)
JULIA_EMAIL=julia.m.floresss@gmail.com
